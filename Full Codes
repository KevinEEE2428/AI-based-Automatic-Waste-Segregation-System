#1. Dataset Curation & Relabeling Manifest
"""
Dataset Pre-processing and Stratified Split Script
Audits raw input directories, groups files by stem to eliminate data leakage,
applies manual relabeling manifests, and produces train/val partitions.
"""

import os
import shutil
import random
from collections import defaultdict

# Deterministic seeding
SEED = 42
random.seed(SEED)

RAW_DATA_DIR = "data/raw_kaggle"
SUPP_DATA_DIR = "data/supplementary_packaging"
OUTPUT_DIR = "data/sanitized"
TRAIN_RATIO = 0.82

# Verified misclassified stems in public repository
RELABEL_TO_BIO = {
    "cardboard_box_012", "kraft_paper_044", "egg_carton_003", 
    "paper_cup_crushed_09", "corrugated_sheet_21", "bagasse_bowl_11"
}

def get_stem_groups(directory):
    groups = defaultdict(list)
    for root, _, files in os.walk(directory):
        for f in files:
            if f.lower().endswith(('.png', '.jpg', '.jpeg')):
                path = os.path.join(root, f)
                # Extract filename stem prior to sequence/augmentation indicators
                stem = f.split('_')[0]
                groups[stem].append(path)
    return groups

def main():
    bio_groups = get_stem_groups(os.path.join(RAW_DATA_DIR, "O"))
    non_bio_groups = get_stem_groups(os.path.join(RAW_DATA_DIR, "R"))
    
    # Apply relabeling manifests
    for stem in list(non_bio_groups.keys()):
        if stem in RELABEL_TO_BIO:
            bio_groups[stem].extend(non_bio_groups.pop(stem))
            
    print(f"Grouped unique stems -> Bio: {len(bio_groups)}, Non-Bio: {len(non_bio_groups)}")

    # Partition groups deterministically to prevent cross-split leakage
    for cls_name, groups in [("biodegradable", bio_groups), ("non_biodegradable", non_bio_groups)]:
        stems = list(groups.keys())
        random.shuffle(stems)
        
        split_idx = int(len(stems) * TRAIN_RATIO)
        train_stems = stems[:split_idx]
        val_stems = stems[split_idx:]
        
        for split, split_stems in [("train", train_stems), ("val", val_stems)]:
            target_dir = os.path.join(OUTPUT_DIR, split, cls_name)
            os.makedirs(target_dir, exist_ok=True)
            for stem in split_stems:
                for file_path in groups[stem]:
                    shutil.copy(file_path, target_dir)

if __name__ == "__main__":
    main()
#2. Transfer Learning Model Architecture
"""
ResNet-18 Transfer Learning Architecture
Freezes early feature extractors, retains spatial context in deeper layers,
and exposes a lightweight binary classification head.
"""

import torch
import torch.nn as nn
from torchvision import models

class WasteClassifier(nn.Module):
    def __init__(self, num_classes=2, dropout_rate=0.3):
        super(WasteClassifier, self).__init__()
        # Load ImageNet pre-trained backbone
        weights = models.ResNet18_Weights.DEFAULT
        self.backbone = models.resnet18(weights=weights)
        
        # Freeze conv1, bn1, layer1, and layer2
        for name, param in self.backbone.named_parameters():
            if not any(k in name for k in ["layer3", "layer4", "fc"]):
                param.requires_grad = False
                
        # Replace fully connected head with regularized linear block
        in_features = self.backbone.fc.in_features
        self.backbone.fc = nn.Sequential(
            nn.Dropout(p=dropout_rate),
            nn.Linear(in_features, num_classes)
        )
        
    def forward(self, x):
        return self.backbone(x)

def get_model(num_classes=2, device="cpu"):
    model = WasteClassifier(num_classes=num_classes)
    return model.to(device)
#3. Training and Evaluation Script
"""
Model Training and Validation Pipeline
Implements Cross-Entropy optimization, learning rate stepping, and checkpointing.
"""

import torch
import torch.nn as nn
from torch.utils.data import DataLoader
from torchvision import datasets, transforms
from model import get_model

def get_dataloaders(data_dir, batch_size=32):
    train_transform = transforms.Compose([
        transforms.Resize((224, 224)),
        transforms.RandomHorizontalFlip(p=0.5),
        transforms.RandomRotation(degrees=15),
        transforms.ColorJitter(brightness=0.1, contrast=0.1),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
    ])
    
    val_transform = transforms.Compose([
        transforms.Resize((224, 224)),
        transforms.ToTensor(),
        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
    ])
    
    train_set = datasets.ImageFolder(f"{data_dir}/train", transform=train_transform)
    val_set = datasets.ImageFolder(f"{data_dir}/val", transform=val_transform)
    
    train_loader = DataLoader(train_set, batch_size=batch_size, shuffle=True, num_workers=2)
    val_loader = DataLoader(val_set, batch_size=batch_size, shuffle=False, num_workers=2)
    return train_loader, val_loader

def train_model(epochs=15, lr=0.0003):
    device = torch.device("cpu")
    torch.set_num_threads(4)
    
    train_loader, val_loader = get_dataloaders("data/sanitized")
    model = get_model(num_classes=2, device=device)
    
    criterion = nn.CrossEntropyLoss()
    optimizer = torch.optim.Adam(filter(lambda p: p.requires_grad, model.parameters()), lr=lr, weight_decay=1e-4)
    
    best_acc = 0.0
    for epoch in range(epochs):
        model.train()
        running_loss = 0.0
        for inputs, labels in train_loader:
            inputs, labels = inputs.to(device), labels.to(device)
            optimizer.zero_grad()
            outputs = model(inputs)
            loss = criterion(outputs, labels)
            loss.backward()
            optimizer.step()
            running_loss += loss.item() * inputs.size(0)
            
        # Validation pass
        model.eval()
        corrects = 0
        with torch.no_grad():
            for inputs, labels in val_loader:
                inputs, labels = inputs.to(device), labels.to(device)
                preds = torch.argmax(model(inputs), dim=1)
                corrects += torch.sum(preds == labels.data)
                
        val_acc = corrects.double() / len(val_loader.dataset)
        print(f"Epoch {epoch+1:02d}/{epochs:02d} | Loss: {running_loss/len(train_loader.dataset):.4f} | Val Acc: {val_acc:.4f}")
        
        if val_acc > best_acc:
            best_acc = val_acc
            torch.save(model.state_dict(), "models/resnet18_waste_classifier.pth")

if __name__ == "__main__":
    train_model()
#4. Edge Inference, Pre-Filtering, & Serial Dispatch
"""
Real-time Vision Pipeline with Background Variance Gating,
Temporal Confirmation Logic, and PySerial Actuation.
"""

import cv2
import time
import serial
import torch
from torchvision import transforms
from PIL import Image
from model import get_model

# Communication Setup
SERIAL_PORT = "COM11"
BAUD_RATE = 9600
VAR_THRESHOLD = 110.0      # Laplacian edge variance cut-off
CONF_THRESHOLD = 0.75     # Minimum Softmax confidence
CONFIRM_TIME = 5.0        # Continuous stability requirement in seconds

CLASSES = ["Biodegradable", "Non-Biodegradable"]

# Tensor normalizer matching validation pipeline
transform = transforms.Compose([
    transforms.Resize((224, 224)),
    transforms.ToTensor(),
    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
])

def init_serial():
    try:
        ser = serial.Serial(SERIAL_PORT, BAUD_RATE, timeout=1)
        time.sleep(2.0)
        return ser
    except Exception as e:
        print(f"Serial connection warning: {e}")
        return None

def main():
    ser = init_serial()
    device = torch.device("cpu")
    torch.set_num_threads(4)

    model = get_model(num_classes=2, device=device)
    model.load_state_dict(torch.load("models/resnet18_waste_classifier.pth", map_location=device))
    model.eval()

    cap = cv2.VideoCapture(0)
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

    tracked_class = None
    timer_start = 0.0

    while cap.isOpened():
        ret, frame = cap.read()
        if not ret:
            break

        # Slicing Region of Interest (280x280 from optical centre)
        h, w, _ = frame.shape
        x1, y1 = (w - 280) // 2, (h - 280) // 2
        roi = frame[y1:y1+280, x1:x1+280]

        # Stage Presence Gating via Laplacian Variance
        gray = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)
        var_score = cv2.Laplacian(gray, cv2.CV_64F).var()

        status_text = "Stage Empty"
        progress = 0.0

        if var_score >= VAR_THRESHOLD:
            # Prepare tensor for model execution
            rgb_roi = cv2.cvtColor(roi, cv2.COLOR_BGR2RGB)
            pil_img = Image.fromarray(rgb_roi)
            tensor = transform(pil_img).unsqueeze(0).to(device)

            with torch.no_grad():
                probs = torch.softmax(model(tensor), dim=1)[0]
                conf, pred_idx = torch.max(probs, dim=0)
                conf = conf.item()
                pred_class = pred_idx.item()

            if conf >= CONF_THRESHOLD:
                curr_time = time.time()
                if tracked_class != pred_class:
                    tracked_class = pred_class
                    timer_start = curr_time
                else:
                    elapsed = curr_time - timer_start
                    progress = min(1.0, elapsed / CONFIRM_TIME)
                    status_text = f"Confirming: {CLASSES[pred_class]} ({conf*100:.1f}%)"

                    if elapsed >= CONFIRM_TIME:
                        # Dispatch single-byte command to microcontroller
                        cmd = b'B' if pred_class == 0 else b'N'
                        if ser and ser.is_open:
                            ser.write(cmd)
                        status_text = f"SORTED: {CLASSES[pred_class]}"
                        tracked_class = None
                        time.sleep(3.5)  # Lock pipeline during physical flap discharge
            else:
                tracked_class = None
                status_text = "Uncertain Object"
        else:
            tracked_class = None

        # Render User Interface Overlays
        cv2.rectangle(frame, (x1, y1), (x1+280, y1+280), (0, 255, 0), 2)
        cv2.putText(frame, f"Var: {var_score:.1f}", (x1, y1 - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)
        cv2.putText(frame, status_text, (20, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 255), 2)
        
        # Confirmation Progress Bar
        bar_w = int(280 * progress)
        cv2.rectangle(frame, (x1, y1+290), (x1+280, y1+305), (100, 100, 100), -1)
        cv2.rectangle(frame, (x1, y1+290), (x1+bar_w, y1+305), (0, 255, 0), -1)

        cv2.imshow("Waste Classification Station", frame)
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()
    if ser and ser.is_open:
        ser.close()

if __name__ == "__main__":
    main()
#5. Arduino Uno Actuation Firmware
/*
 * Microcontroller Actuation Firmware
 * Receives UART single-byte triggers from host vision pipeline
 * Actuates SG90 servo flap to divert waste into designated bins.
 */

#include <Servo.h>

Servo sortingFlap;

const int SERVO_PIN = 9;
const int POS_NEUTRAL = 90;
const int POS_BIO = 0;           // Left chute deflection
const int POS_NON_BIO = 180;     // Right chute deflection
const unsigned long HOLD_TIME = 3000; // Hold flap for mechanical discharge (ms)

void setup() {
  Serial.begin(9600);
  sortingFlap.attach(SERVO_PIN);
  sortingFlap.write(POS_NEUTRAL);
}

void loop() {
  if (Serial.available() > 0) {
    char cmd = Serial.read();

    if (cmd == 'B') {
      // Divert to Biodegradable bin
      sortingFlap.write(POS_BIO);
      delay(HOLD_TIME);
      sortingFlap.write(POS_NEUTRAL);
    } 
    else if (cmd == 'N') {
      // Divert to Non-Biodegradable bin
      sortingFlap.write(POS_NON_BIO);
      delay(HOLD_TIME);
      sortingFlap.write(POS_NEUTRAL);
    }
  }
}
